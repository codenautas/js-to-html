{
  "name": "js-to-html",
  "description": "Create HTML text from JS object",
  "version": "1.4.0",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "repository": "codenautas/js-to-html",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    }
  ],
  "main": "lib/js-to-html.js",
  "types": "lib/js-to-html.d.ts",
  "files": [
    "lib"
  ],
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "uuid": ">=14.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  },
  "devDependencies": {
    "best-globals": "^2.2.3",
    "expect.js": "^0.3.1",
    "mocha": "^12.0.3",
    "moment": "^2.31.0",
    "nyc": "^18.0.0",
    "qa-control": "^0.12.2",
    "require-bro": "^0.4.1",
    "server4test": "^2.0.0-rc.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 22"
  },
  "nyc": {
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "scripts": {
    "build": "tsc",
    "build-test": "npm run build && nyc instrument --delete lib local-instrumented/lib",
    "test": "npm run build && npm run test-ss",
    "test-ss": "mocha --reporter spec --bail --check-leaks test/",
    "test-ci": "npm run build && nyc --silent mocha --reporter dot --check-leaks test/ && npm run test-navigator && nyc report",
    "test-navigator": "npm run build-test && server4test --run-browser chrome,firefox",
    "test-navigator-inf": "npm run build-test && server4test",
    "start": "node example/server.js"
  },
  "tonicExampleFilename": "examples/tonic/js-to-html-tonic-example.js",
  "qa-control": {
    "gha": "all",
    "coverage": 95,
    "run-in": "both",
    "type": "lib"
  }
}
