{
  "name": "js-to-html",
  "description": "Create HTML text from JS object",
  "version": "1.4.0",
  "author": "Codenautas <codenautas@googlegroups.com>",
  "license": "MIT",
  "repository": "codenautas/js-to-html",
  "contributors": [
    {
      "name": "Emilio Platzer",
      "email": "emilioplatzer@gmail.com"
    }
  ],
  "main": "lib/js-to-html.js",
  "types": "lib/js-to-html.d.ts",
  "files": [
    "lib"
  ],
  "overrides": {
    "diff": ">=8.0.2",
    "serialize-javascript": ">=7.0.0",
    "stylus": {
      "glob": "^11"
    },
    "uuid": ">=14.0.0"
  },
  "devDependencies": {
    "best-globals": "^2.2.2",
    "body-parser": "^2.3.0",
    "classlist.js": "^1.1.20150312",
    "cookie-parser": "^1.4.7",
    "es6-promise": "^4.2.8",
    "expect.js": "^0.3.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "follow-redirects": ">=1.16.0",
    "fs-promise": "^2.0.3",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-coverage-html-index-reporter": "^1.0.2",
    "karma-expect": "^1.1.3",
    "karma-firefox-launcher": "^2.1.3",
    "karma-mocha": "^2.0.1",
    "karma-safari-launcher": "^1.0.0",
    "mini-tools": "^1.13.10",
    "mocha": "^12.0.0-rc.5",
    "moment": "^2.30.1",
    "nyc": "^18.0.0",
    "pug": "^3.0.4",
    "require-bro": "^0.3.6",
    "qa-control": "^0.9.2",
    "serve-content": "^1.0.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">= 22"
  },
  "nyc": {
    "reporter": [
      "lcov",
      "text-summary"
    ]
  },
  "scripts": {
    "build": "tsc",
    "infinito": "node examples/server/server.js --karma karma.conf.js",
    "test": "npm run build && node examples/server/server.js --karma karma.conf.js --single-run",
    "test-ss": "mocha --reporter spec --bail --check-leaks test/",
    "test-cov": "npm run build && node examples/server/server.js --karma karma.conf.js --single-run",
    "test-ci": "npm run test-cov",
    "start": "node example/server.js"
  },
  "tonicExampleFilename": "examples/tonic/js-to-html-tonic-example.js",
  "qa-control": {
    "gha": "all",
    "package-version": "0.3.0",
    "coverage": 100,
    "run-in": "both",
    "stability": "stable",
    "type": "lib"
  }
}
